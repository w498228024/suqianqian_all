.page-mine {
  min-height: 100vh;
}

/* 未登录 */
.not-login {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
}

.login-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.login-icon {
  font-size: 100rpx;
}

.login-text {
  font-size: 28rpx;
  color: #666;
}

.login-btn {
  width: 400rpx;
  margin-top: 20rpx;
}

/* 菜单 */
.menu-section {
  background: #fff;
  margin: 20rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item.active {
  background: #eef0ff;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.menu-item.logout .menu-text {
  color: #e74c3c;
}

/* 列表 */
.list-section {
  padding: 20rpx 30rpx;
}

.list-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.card-desc {
  font-size: 24rpx;
  color: #888;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.status-published {
  background: #d4edda;
  color: #155724;
}

.status-pending {
  background: #fff3cd;
  color: #856404;
}

.status-rejected {
  background: #f8d7da;
  color: #721c24;
}

.loading-tip {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}
