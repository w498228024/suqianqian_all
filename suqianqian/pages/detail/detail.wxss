.page-detail {
  padding-bottom: 40rpx;
}

/* 头部 */
.detail-header {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 2rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.detail-desc {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
}

/* 操作栏 */
.action-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.action-btn {
  flex: 1;
  font-size: 26rpx;
  padding: 16rpx 0;
  text-align: center;
  border-radius: 8rpx;
  line-height: 1.5;
}

.action-btn::after { border: none; }

.fav-btn {
  width: 80rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  background: #f5f5f5;
  font-size: 40rpx;
  color: #999;
}

.fav-btn.favorited {
  color: #e74c3c;
  background: #fde8e8;
}

/* 心跳动画 */
.fav-btn.animating .fav-icon {
  animation: heartBeat 0.4s ease-in-out;
}

@keyframes heartBeat {
  0%   { transform: scale(1); }
  25%  { transform: scale(1.35); }
  50%  { transform: scale(0.9); }
  75%  { transform: scale(1.15); }
  100% { transform: scale(1); }
}

.fav-icon {
  display: inline-block;
  transition: color 0.2s ease;
}

/* Markdown 内容 */
.md-content {
  padding: 30rpx;
  background: #fff;
  margin-top: 16rpx;
}

.md-h1 {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin: 24rpx 0 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #eee;
}

.md-h2 {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin: 20rpx 0 12rpx;
}

.md-h3 {
  font-size: 30rpx;
  font-weight: bold;
  color: #444;
  display: block;
  margin: 16rpx 0 10rpx;
}

.md-p {
  font-size: 28rpx;
  color: #444;
  display: block;
  margin: 8rpx 0;
  line-height: 1.8;
}

.md-li {
  font-size: 28rpx;
  color: #444;
  display: block;
  margin: 6rpx 0;
  padding-left: 20rpx;
  line-height: 1.8;
}

.md-code-block {
  background: #f6f8fa;
  border-radius: 8rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  overflow-x: auto;
}

.code-lang {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.code-text {
  font-size: 26rpx;
  color: #24292e;
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  white-space: pre;
  display: block;
  line-height: 1.6;
}

.md-hr {
  height: 2rpx;
  background: #eee;
  margin: 24rpx 0;
}

.md-br {
  height: 16rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
  color: #999;
  font-size: 28rpx;
}
