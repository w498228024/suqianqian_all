.page-classify {
  display: flex;
  flex-direction: row;
  min-height: 100vh;
}

/* 左侧分类树 */
.category-tree {
  width: 280rpx;
  background: #fff;
  border-right: 1rpx solid #eee;
  overflow-y: auto;
}

.cat-group {
  border-bottom: 1rpx solid #f5f5f5;
}

.cat-parent {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  font-size: 26rpx;
  color: #333;
}

.cat-parent.active {
  background: #eef0ff;
  color: #667eea;
  font-weight: 600;
}

.cat-count {
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

.cat-children {
  background: #fafafa;
}

.cat-child {
  padding: 20rpx 24rpx 20rpx 48rpx;
  font-size: 24rpx;
  color: #666;
  border-bottom: 1rpx solid #f0f0f0;
}

.cat-child.active {
  color: #667eea;
  background: #eef0ff;
}

/* 右侧 Skill 列表 */
.skill-panel {
  flex: 1;
  overflow-y: auto;
}

.panel-header {
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.skill-list {
  padding: 20rpx;
}

.skill-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #888;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.card-tags {
  margin-bottom: 8rpx;
}

.loading-tip {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
}
