<view class="page-index">
  <!-- 顶部公告 -->
  <view class="notice-bar">
    <text class="notice-text">{{notice}}</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索 Skill..." value="{{searchKey}}"
        bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
      <text class="search-clear" wx:if="{{searchKey}}" bindtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- 分类标签横向滚动 -->
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view class="category-item {{activeCategory === '' ? 'active' : ''}}"
      data-cat="" bindtap="onCategoryTap">全部</view>
    <view class="category-item {{activeCategory === item.name ? 'active' : ''}}"
      wx:for="{{categories}}" wx:key="name"
      data-cat="{{item.name}}" bindtap="onCategoryTap">{{item.name}}</view>
  </scroll-view>

  <!-- Skill 卡片流 -->
  <view class="skill-list">
    <view class="skill-card" wx:for="{{skills}}" wx:key="id"
      data-id="{{item.id}}" bindtap="onSkillTap">
      <view class="card-header">
        <text class="card-title">{{item.title}}</text>
        <text class="card-category tag tag-primary">{{item.category}}</text>
      </view>
      <text class="card-desc">{{item.desc}}</text>
      <view class="card-tags">
        <text class="tag tag-success" wx:for="{{item.fit_tools}}" wx:for-item="tool" wx:key="*this">{{tool}}</text>
        <text class="tag tag-warning" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
      <view class="card-footer">
        <text class="card-author" wx:if="{{item.author}}">by {{item.author}}</text>
        <text class="card-collect">❤ {{item.collect_num}}</text>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-tip" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    <view class="loading-tip" wx:if="{{!hasMore && skills.length > 0}}">
      <text>— 没有更多了 —</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && skills.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无 Skill，快来上传第一个吧</text>
    </view>
  </view>

  <!-- 底部 Banner 广告 -->
  <ad wx:if="{{adEnabled}}" unit-id="ad-unit-home" ad-type="banner" ad-theme="white"></ad>
</view>
