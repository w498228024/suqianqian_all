.page-upload {
  padding: 20rpx 30rpx 60rpx;
}

.form-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  padding: 16rpx 20rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  background: #fafafa;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 16rpx 20rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  min-height: 120rpx;
  background: #fafafa;
  box-sizing: border-box;
}

.md-editor {
  min-height: 400rpx;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 26rpx;
  line-height: 1.6;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.picker-btn {
  padding: 16rpx 20rpx;
  background: #fafafa;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  min-width: 200rpx;
}

/* 适配平台标签 */
.tool-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tool-tag {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
}

.tool-tag.active {
  background: #667eea;
  color: #fff;
}

/* 协议勾选 */
.agree-section {
  padding: 20rpx 24rpx;
}

.agree-label {
  display: flex;
  align-items: flex-start;
}

.agree-text {
  font-size: 24rpx;
  color: #666;
  margin-left: 12rpx;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after { border: none; }
